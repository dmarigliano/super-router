# Environment variable reference for Super Router.
#
# The CLI does not load .env files automatically. Export these variables from
# your shell or inject them with your OS/service secret manager. Never commit
# .env files or real credentials.

# Optional trusted configuration path. A config selected here may define
# providers and executables; prefer an absolute path outside untrusted repos.
# SUPER_ROUTER_CONFIG=/absolute/path/to/providers.config.json

# Optional trusted state root. Memory and telemetry stay outside the repository
# by default, so most users should leave this unset.
# SUPER_ROUTER_STATE_DIR=/absolute/path/to/trusted/state

# BYOK credentials for the optional metered, non-streaming, text-only HTTP
# adapters. Leave these unset when using Claude Code or Codex subscription CLIs.
# Export a key only when the corresponding provider is explicitly enabled.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
